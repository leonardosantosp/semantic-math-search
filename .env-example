# Generate embedding api_url (disponível em: https://github.com/leonardosantosp/embedding-service)
GENERATE_EMBEDDINGS_API_URL="http://localhost:8000"

# Generate tokens api_url (disponível em: https://github.com/YwaoFugimoto/tcc-java-codes)
GENERATE_TOKENS_API_URL="http://localhost:8080"

# Your elastic user
ELASTIC_USER=elastic

# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=your_password

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=your_password

# Version of Elastic products
STACK_VERSION=8.17.2

# Set the cluster name
CLUSTER_NAME=docker-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic
#LICENSE=trial

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200
#ES_PORT=127.0.0.1:9200

# Port to expose Kibana to the host
KIBANA_PORT=5601
#KIBANA_PORT=80

# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=1073741824